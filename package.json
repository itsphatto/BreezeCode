{
  "name": "breeze-code",
  "private": true,
  "version": "0.7.4",
  "description": "Blazing Fast Muti Agent IDE",
  "author": "itsphatto",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/main/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsc && node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/termPreload.js && node --test \"test/**/*.test.js\"",
    "build:engine": "node scripts/build-engine.js",
    "test:engine": "cargo test --release --manifest-path engine/Cargo.toml -- --include-ignored",
    "dist": "tsc && electron-builder --win --publish never",
    "predist": "node scripts/write-config.js && node scripts/build-engine.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsphatto/BreezeCode.git"
  },
  "build": {
    "appId": "com.breeze.ide",
    "productName": "Breeze Code",
    "publish": [
      {
        "provider": "github",
        "owner": "itsphatto",
        "repo": "BreezeCode",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "runtime/**",
      "package.json",
      "breeze.config.json"
    ],
    "asarUnpack": [
      "runtime/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/brand/Icon.png"
    },
    "nsis": {
      "artifactName": "Breeze-Code-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "node_modules/@typescript/typescript-${platform}-${arch}/lib",
        "to": "typescript",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "emmet": "^2.4.11",
    "firebase": "^13.2.0",
    "morphicons": "^2.0.0"
  }
}
